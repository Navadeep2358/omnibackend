NODE_ENV=development
PORT=3001
HOST=127.0.0.1
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=omnicloud_auth
MYSQL_SSL=false
MYSQL_CREATE_DATABASE=true

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Production AWS login is hosted by OmniCloud; it does not use the deployer's
# AWS CLI profile. Use the public HTTPS origin serving this app and API.
OMNICLOUD_PUBLIC_URL=https://omnicloud.example.com
AWS_SSO_START_URL=
AWS_SSO_REGION=
AWS_SSO_ISSUER_URL=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep stable across all backend replicas and protect it like a database secret.
AWS_SSO_TOKEN_ENCRYPTION_KEY=
AWS_REGION=ap-south-1

# OmniCloud's Google Cloud workload identity service account (no JSON key file).
# Grant this principal roles/iam.serviceAccountTokenCreator on each customer SA.
OMNICLOUD_GCP_SERVICE_ACCOUNT_EMAIL=omnicloudofficial@gmail.com

# Azure Lighthouse managing tenant and the service principal object ID authorized
# in each customer delegation. These are OmniCloud identity IDs, never customer keys.

# Use cli for local development; use managed_identity, service_principal, or oidc
# for deployment hosts. Any ARM_* secret/token belongs only to OmniCloud's backend.
OMNICLOUD_AZURE_AUTH_MODE=cli
ARM_TENANT_ID=
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_OIDC_TOKEN=
AZURE_CLI_BIN=az

# No developer AWS CLI profile or static AWS keys are required for user SSO.

# Optional overrides. Terraform must be installed and on PATH if TERRAFORM_BIN is blank.
TERRAFORM_BIN=
TERRAFORM_STATE_DIR=
TERRAFORM_PLUGIN_CACHE_DIR=

# Hosting switches. Render uses a separate Netlify frontend and has no local Docker daemon.
SERVE_FRONTEND=true
OMNICLOUD_LOCAL_DOCKER_BUILDS=true
